<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <!-- LineLength est un enfant de Checker (et non de TreeWalker) depuis Checkstyle 8.24. -->
    <module name="LineLength"><property name="max" value="120"/></module>
    <module name="TreeWalker">
        <module name="MethodLength"><property name="max" value="30"/></module>
        <!-- Les signatures imposées par le framework (@Override) ne sont pas de notre fait.
             Methodes seulement : un constructeur (injection de dependances) prend autant
             de parametres que necessaire. -->
        <module name="ParameterNumber">
            <property name="max" value="4"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <!-- "log" autorise : nom standard du logger SLF4J (et celui genere par @Slf4j). -->
        <module name="ConstantName"><property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/></module>
        <module name="PackageName"><property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/></module>
    </module>
</module>