# Copier en .env (jamais commite). Facultatif en local : sans .env, le profil "local" vise
# deja le PostgreSQL natif (WSL) sur localhost:5432 avec ces memes valeurs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valimbavaka
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Authentification (AUTH-01) : le profil local fournit un secret JWT de dev. Pour le surcharger
# (32 caracteres minimum) : JWT_SECRET=...
# JWT_SECRET=

# Premier administrateur (SYS-05) : lu seulement si aucun administrateur n existe en base.
# Mot de passe de 15 caracteres minimum, a changer a la premiere connexion.
# Decommenter pour surcharger les valeurs de dev (une variable vide ferait echouer le demarrage).
# ADMIN_EMAIL=admin@valimbavaka.mg
# ADMIN_PASSWORD=admin-local-a-changer
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=Local

# Base locale ci-dessus = PostgreSQL natif (WSL) sur 5432. Pour utiliser plutot la base Docker
# (`docker compose up -d postgres`) : DB_PORT=5433, DB_USERNAME=valimbavaka, DB_PASSWORD=valimbavaka.

# Stack Docker (docker compose) : base propre, independante des DB_* ci-dessus
# DOCKER_DB_PORT=5433
# DOCKER_DB_NAME=valimbavaka
# DOCKER_DB_USERNAME=valimbavaka
# DOCKER_DB_PASSWORD=valimbavaka
# CORE_PORT=8080
# UI_PORT=4200
