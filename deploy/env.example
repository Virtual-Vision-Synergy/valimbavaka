# Modele de fichier d'environnement. Ne jamais committer la copie remplie.
#
#   EliteBook : copier en ~/valimbavaka/.env.staging et ~/valimbavaka/.env.prod
#   Njara (QA) : copier en deploy/.env.qa (ignore par Git)
#
# TAG n'est pas a renseigner pour staging/prod : deploy.sh le fournit (version deployee).
# Pour la QA, decommenter TAG=develop tout en bas.

# staging | prod  (la QA utilise staging)
SPRING_PROFILE=staging

# staging : 8081 | prod : 80 | qa : 8090
HTTP_PORT=8081

DB_NAME=valimbavaka
DB_USERNAME=valimbavaka
DB_PASSWORD=a-changer-mot-de-passe-long-et-unique

# Limites memoire (EliteBook : WSL plafonne a 10 Go, poste partage avec la bureautique).
CORE_MEM_LIMIT=1g
DB_MEM_LIMIT=512m

# Prod uniquement : dossier des sauvegardes sur le poste (chemin absolu).
# BACKUP_DIR=/home/UTILISATEUR/valimbavaka/backups/prod

# QA uniquement :
# TAG=develop
